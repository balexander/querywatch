# Local development
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter with OpenAI SDK compatibility
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# querywatch defaults
QUERYWATCH_REASONING_MODEL=anthropic/claude-sonnet-4.5
QUERYWATCH_TRIAGE_MODEL=anthropic/claude-haiku-4.5
QUERYWATCH_SOURCE_TABLE=system.query.history
QUERYWATCH_RESULTS_TABLE=main.querywatch.optimization_results
QUERYWATCH_TOP_N=10
QUERYWATCH_N_RUNS=3
QUERYWATCH_SECRET_SCOPE=querywatch-secrets
QUERYWATCH_SECRET_KEY=openrouter-api-key
